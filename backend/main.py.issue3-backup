                            f"Navigation did not complete after step {index}: {exc}"
                        )
            # Refresh the UI after every click so newly opened editors are detected.
            if action == "click":
                try:
                    current_snapshot = get_fresh_app_snapshot(app_name)
                    valid_refs = set(
                        re.findall(r"@e\d+", current_snapshot)
                    )
                except HTTPException as exc:
                    raise RuntimeError(
                        f"Could not refresh UI after click in step {index}: {exc.detail}"
                    )
            # After creating a new document, verify that its editor is blank.
            if action == "key" and value == "ctrl+n":

                try:
                    new_snapshot = run_agent_cu(
                        ["snapshot", "--app", app_name, "-i", "-c"],
                        timeout=15
                    )

                except HTTPException as exc:
                    return {
                        "success": False,
                        "failed_step": index,
                        "completed_steps": results,
                        "error": f"Could not verify the new document: {exc.detail}",
                        "execution_status": "stopped"
                    }

                # Compare editable controls before and after creating a new document.
                editable_pattern = re.compile(
                    r'\[@(e\d+)\]\s+(textarea|textfield)\b(.*)',
                    re.IGNORECASE
                )

                def get_editable_controls(snapshot):
                    controls = []

                    for line in snapshot.splitlines():
                        match = editable_pattern.search(line)

                        if not match:
                            continue

                        value_match = re.search(
                            r'\bval="([^"]*)"',
                            match.group(3)
                        )

                        controls.append({
                            "ref": match.group(1),
                            "blank": (
                                value_match is not None
                                and value_match.group(1) == ""
                            )
                        })

                    return controls

                previous_controls = get_editable_controls(
                    current_snapshot
                )

                new_controls = get_editable_controls(
                    new_snapshot
                )

                
                # Compare blank editable controls using their UI metadata.
                previous_blank_signatures = {}

                for line in current_snapshot.splitlines():
                    match = editable_pattern.search(line)

                    if not match:
                        continue

                    value_match = re.search(
                        r'\bval="([^"]*)"',
                        match.group(3)
                    )

                    if value_match is None or value_match.group(1) != "":
                        continue

                    signature = re.sub(
                        r'\[@e\d+\]',
                        '',
                        line
                    ).strip()

                    previous_blank_signatures[signature] = (
                        previous_blank_signatures.get(signature, 0) + 1
                    )

                new_blank_controls = []

                for control in new_controls:
                    if not control["blank"]:
                        continue

                    line = next(
                        (
                            item for item in new_snapshot.splitlines()
                            if re.search(
                                rf'\[@{re.escape(control["ref"])}\]',
                                item
                            )
                        ),
                        None
                    )

                    if line is None:
                        continue

                    signature = re.sub(
                        r'\[@e\d+\]',
                        '',
                        line
                    ).strip()

                    previous_count = previous_blank_signatures.get(
                        signature, 0
                    )

                    already_selected = sum(
                        1 for item in new_blank_controls
                        if item["signature"] == signature
                    )

                    if already_selected >= previous_count:
                        new_blank_controls.append({
                            "ref": control["ref"],
                            "signature": signature
                        })

                if len(new_blank_controls) != 1:
                    print("========== NOTEPAD BEFORE CTRL+N ==========")
                    print(current_snapshot)

                    print("========== NOTEPAD AFTER CTRL+N ==========")
                    print(new_snapshot)

                    print("========== PREVIOUS EDITORS ==========")
                    print(previous_controls)

                    print("========== NEW EDITORS ==========")
                    print(new_controls)

                    print("========== NEW BLANK EDITORS ==========")
                    print(new_blank_controls)
                    return {
                        "success": False,
                        "failed_step": index,
                        "completed_steps": results,
                        "error": (
                            "Could not uniquely identify the newly created "
                            "blank editor. Pasting was stopped to protect "
                            "existing content."
                        ),
                        "execution_status": "stopped"
                    }

                new_editor_ref = new_blank_controls[0]["ref"]
                # Explicitly focus the newly created editor before pasting.
                focus_output = run_agent_cu(
                    ["focus", f"@{new_editor_ref}", "--app", app_name],
                    timeout=15
                )

                focus_result = json.loads(focus_output)

                if not focus_result.get("success", False):
                    return {
                        "success": False,
                        "failed_step": index,
                        "completed_steps": results,
                        "error": "Could not focus the newly created editor. Pasting was stopped.",
                        "execution_status": "stopped"
                    }
                # Update references using the refreshed UI snapshot.
                valid_refs = set(
                    re.findall(r"@e\d+", new_snapshot)
                )
                current_snapshot = new_snapshot


        except (HTTPException, RuntimeError) as exc:

            error_message = (
                str(exc.detail)
                if isinstance(exc, HTTPException)
                else str(exc)
            )

            return {
                "success": False,
                "failed_step": index,
                "completed_steps": results,
                "results": results + [{
                    "step": index,
                    "app": app_name,
                    "action": action,
                    "success": False,
                    "error": error_message
                }],
                "execution_status": "stopped"
            }

    return {
        "success": True,
        "results": results,
        "execution_status": "completed"
    }
