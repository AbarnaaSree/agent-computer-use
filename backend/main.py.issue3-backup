def find_and_launch_app(app_name: str):
    """Find and launch a Windows app if it is not running."""

    app_alias = app_name.strip().lower().replace("microsoft ", "")

    # Check whether the app is already running.
    windows_output = run_agent_cu(["windows"], timeout=10)
    print("WINDOWS CLI OUTPUT:", repr(windows_output))
    windows = json.loads(windows_output)

    for window in windows:
        title = window.get("title", "").strip().lower()
        app = window.get("app", "").strip().lower()

        if app_alias in title or app_alias in app:
            return

    # Find the app's Start Menu AppID.
    safe_name = app_name.replace("'", "''")

    command = (
        "Get-StartApps | "
        f"Where-Object {{ $_.Name -eq '{safe_name}' }} | "
        "Select-Object -First 1 Name, AppID | "
        "ConvertTo-Json -Compress"
    )

    result = subprocess.run(
        ["powershell.exe", "-NoProfile", "-Command", command],
        capture_output=True,
        text=True,
        timeout=20,
        check=False
    )

    if result.returncode != 0 or not result.stdout.strip():
        raise HTTPException(
            status_code=404,
            detail=f"Installed application not found: {app_name}"
        )

    application = json.loads(result.stdout)

    if not isinstance(application, dict) or not application.get("AppID"):
        raise HTTPException(
            status_code=404,
            detail=f"No valid application ID found for: {app_name}"
        )

    app_id = application["AppID"]

    # Launch the application.
    subprocess.Popen(
        ["explorer.exe", f"shell:AppsFolder\\{app_id}"],
        creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0)
    )

def get_agent_app_name(app_name: str) -> str:
    return app_name

def run_agent_cu(arguments: list[str], timeout: int = 15):
    if not AGENT_CU.is_file():
        raise HTTPException(
            status_code=500,
            detail="agent-cu executable not found. Build the Rust project first."
        )

    try:
        result = subprocess.run(
            [str(AGENT_CU), *arguments],
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False
        )

        if result.returncode != 0:
            raise HTTPException(
                status_code=500,
                detail=result.stderr.strip() or "Rust CLI execution failed"
            )

        return result.stdout

    except subprocess.TimeoutExpired:
        raise HTTPException(
            status_code=504,
            detail="Rust automation command timed out"
        )


def wait_for_ui_stability(
    app_name: str,
    previous_snapshot: str,
    timeout: int = 20,
    stable_checks: int = 3,
    poll_interval: float = 0.5
):
    """Wait until the application UI changes and becomes stable."""

    deadline = time.monotonic() + timeout
    last_snapshot = None
    consecutive_matches = 0
    detected_change = False

    while time.monotonic() < deadline:
        current_snapshot = run_agent_cu(
            ["snapshot", "--app", app_name, "-i", "-c"],
            timeout=15
        )

        if current_snapshot and current_snapshot != previous_snapshot:
            detected_change = True

            if current_snapshot == last_snapshot:
                consecutive_matches += 1
            else:
                last_snapshot = current_snapshot
                consecutive_matches = 1

            if consecutive_matches >= stable_checks:
                return current_snapshot

        time.sleep(poll_interval)

    if not detected_change:
        raise RuntimeError(
            f"UI did not change in {app_name} after the action."
        )

    raise RuntimeError(
        f"UI did not become stable in {app_name}."
    )

def get_openrouter_client():
    api_key = os.getenv("OPENROUTER_API_KEY")

    if not api_key:
        raise HTTPException(
            status_code=500,
            detail="OPENROUTER_API_KEY is missing from backend/.env"
        )

    return OpenAI(
        base_url="https://openrouter.ai/api/v1",
        api_key=api_key,
        default_headers={
            "HTTP-Referer": "http://localhost:5173",
            "X-Title": "AI Desktop Automation"
        }
    )


class PlanRequest(BaseModel):
    task: str = Field(min_length=3, max_length=500)
    app: str = Field(min_length=1, max_length=80)

class ExecuteStep(BaseModel):
    action: Literal["click", "type", "key"]
    target_ref: str | None = None
    value: str | None = None
    reason: str | None = None


class ExecuteRequest(BaseModel):
    app: str = Field(min_length=1, max_length=80)
    snapshot: str = Field(min_length=1)
    steps: list[ExecuteStep] = Field(min_length=1, max_length=10)
    confirmed: bool = False

# Multi-application automation models

